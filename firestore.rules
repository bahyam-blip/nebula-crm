rules_version = '2';

// ════════════════════════════════════════════════════════════════
// Nebula CRM — Firestore Security Rules with Role-Based Access
// ════════════════════════════════════════════════════════════════
//
// Roles hierarchy:
//   superAdmin  — full god-mode access (can manage admins and team settings)
//   admin       — can manage team members, all data within their team
//   manager     — can view all team data, edit deals/tickets assigned to anyone
//   salesRep    — can manage own contacts, deals, tickets
//   supportAgent — can manage assigned tickets + read all contacts
//   viewer      — read-only access to team data
//
// All users must belong to a team. Data is scoped to teams.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // A signed-in user with no profile yet (mid-signup, or an account
    // created before the bootstrap fix) must fall through to a clean deny
    // rather than erroring on a null document.
    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasProfile() ? userDoc().data.role : 'none';
    }

    function userTeamId() {
      return hasProfile() ? userDoc().data.teamId : '__none__';
    }

    // Exactly one account can create system/bootstrap, and only that
    // account may hold superAdmin. This replaces the old approach of
    // counting the users collection, which rules can never permit.
    // Effective capabilities, mirroring the app's resolution order: an
    // explicit list wins, otherwise fall back to role. Rules are the real
    // boundary here - hiding a button stops an honest mistake, not a
    // modified client.
    function caps() {
      return hasProfile() && userDoc().data.keys().hasAny(['capabilities'])
        ? userDoc().data.capabilities
        : [];
    }

    function hasCap(name) {
      return isSuperAdmin() || name in caps();
    }

    function bootstrapOwner() {
      return exists(/databases/$(database)/documents/system/bootstrap)
        ? get(/databases/$(database)/documents/system/bootstrap).data.ownerId
        : '';
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'superAdmin';
    }

    function isAdmin() {
      return isSignedIn() && userRole() in ['superAdmin', 'admin'];
    }

    function isManager() {
      return isSignedIn() && userRole() in ['superAdmin', 'admin', 'manager'];
    }

    function canEditDeals() {
      return isSignedIn() && userRole() in ['superAdmin', 'admin', 'manager', 'salesRep'];
    }

    function canManageTickets() {
      return isSignedIn() && userRole() in ['superAdmin', 'admin', 'manager', 'supportAgent'];
    }

    function isOwner(resource) {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isAssignee(resource) {
      return isSignedIn() && resource.data.assigneeId == request.auth.uid;
    }

    function sameTeam(resource) {
      return isSignedIn() && resource.data.teamId == userTeamId();
    }

    // ── Bootstrap marker ──────────────────────────────────────
    // Create-once. Firestore rejects a create on an existing document, so
    // the first account to write this wins and no one can take it later.
    match /system/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Commission rate ───────────────────────────────────────
    // Everyone may read the rate (a salesperson needs to know what a sale
    // pays); only an admin sets it.
    match /settings/{teamId} {
      allow read: if isSignedIn();
      allow write: if hasCap('commissions.setRate')
                   || hasCap('team.managePermissions');
    }

    // ── Commissions ───────────────────────────────────────────
    // A closer may create their own record and read it; managers see the
    // whole team and are alone in approving or marking paid, so nobody can
    // sign off their own money.
    match /commissions/{commissionId} {
      allow read: if isSignedIn()
                  && (resource.data.salesPersonId == request.auth.uid
                      || (isManager() && sameTeam(resource)));
      allow create: if isSignedIn()
        && request.resource.data.teamId == userTeamId()
        && request.resource.data.salesPersonId == request.auth.uid;
      allow update: if hasCap('commissions.approve') && sameTeam(resource);
      allow delete: if hasCap('settings.manage') && sameTeam(resource);
    }

    // ── Companies ─────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isSignedIn() && sameTeam(resource);
      allow create: if isSignedIn() && canEditDeals()
        && request.resource.data.teamId == userTeamId();
      allow update: if isSignedIn() && canEditDeals() && sameTeam(resource);
      allow delete: if isManager() && sameTeam(resource);
    }

    // ── Notes and documents ───────────────────────────────────
    // One collection covers both: a document is a note carrying a file URL,
    // which keeps the customer timeline a single ordered stream.
    match /notes/{noteId} {
      allow read: if isSignedIn() && sameTeam(resource);
      allow create: if isSignedIn()
        && request.resource.data.teamId == userTeamId()
        && request.resource.data.authorId == request.auth.uid;
      // Authors edit their own; managers can tidy up anyone's.
      allow update, delete: if isSignedIn() && sameTeam(resource)
        && (resource.data.authorId == request.auth.uid || isManager());
    }

    // ── Invites ───────────────────────────────────────────────
    // Document id is the lowercased email, so signup can resolve its own
    // invite with a single get() before any profile exists.
    match /invites/{email} {
      allow get: if isSignedIn();
      allow list: if isManager();
      allow create, update, delete: if isAdmin();
      // Let the invited user mark their own invite accepted at signup.
      allow update: if isSignedIn()
        && request.resource.data.acceptedBy == request.auth.uid;
    }

    // Migration markers, written once by a super admin.
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── USERS collection ──────────────────────────────────────
    // Each user can read their own profile. Admins can read all team
    // members. SuperAdmins can read anyone. Only superAdmins can change
    // roles; users can update their own non-role fields.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isAdmin() && resource.data.teamId == userTeamId())
      );

      // Self-create on first signup (must include role=employee by default)
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role in ['salesRep', 'supportAgent', 'viewer']
          // Only the account that claimed system/bootstrap may be superAdmin.
          || (request.resource.data.role == 'superAdmin'
              && bootstrapOwner() == request.auth.uid)
        );

      // Self-update (cannot change own role/teamId)
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.teamId == resource.data.teamId)
        // The workspace creator promotes themselves to superAdmin. Gated on
        // owning system/bootstrap, which is create-once, so exactly one
        // account can ever do this and no one can grant it to themselves later.
        || (request.auth.uid == userId
            && request.resource.data.role == 'superAdmin'
            && bootstrapOwner() == request.auth.uid)
        || isSuperAdmin()
        || (isAdmin() && sameTeam(resource)
            && request.resource.data.role in ['salesRep', 'supportAgent', 'viewer', 'manager'])
      );

      // Only superAdmins can delete users (cascades to their data manually)
      allow delete: if isSuperAdmin();
    }

    // ── TEAMS collection ──────────────────────────────────────
    // Team settings: only admins/superAdmins can modify.
    match /teams/{teamId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || userTeamId() == teamId
      );
      allow create: if isSignedIn()
        && request.resource.data.id == teamId
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        isSuperAdmin() || (isAdmin() && teamId == userTeamId())
      );
      allow delete: if isSuperAdmin();
    }

    // ── CONTACTS collection ───────────────────────────────────
    // Sales reps manage their own contacts. Managers/admins can manage
    // all team contacts. Viewers read-only.
    match /contacts/{contactId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || sameTeam(resource)
      );
      // A plain create needs contacts.create. Assigning the new record to
      // somebody else is really distribution, so it needs that capability
      // instead - this is what stops a telecaller importing a list and
      // handing it around.
      allow create: if isSignedIn()
        && request.resource.data.teamId == userTeamId()
        && hasCap('contacts.create')
        && (
          request.resource.data.ownerId == request.auth.uid
          || hasCap('leads.distribute')
        );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isManager() && sameTeam(resource)) ||
        isOwner(resource)
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && sameTeam(resource)) ||
        isOwner(resource)
      );
    }

    // ── DEALS collection ──────────────────────────────────────
    match /deals/{dealId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || sameTeam(resource)
      );
      allow create: if isSignedIn()
        && request.resource.data.teamId == userTeamId()
        && hasCap('deals.edit');
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isManager() && sameTeam(resource)) ||
        isOwner(resource)
      );
      allow delete: if hasCap('deals.delete') && sameTeam(resource);
    }

    // ── ACTIVITIES collection ─────────────────────────────────
    // Activities are append-only logs. Owner or manager can delete.
    match /activities/{activityId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.teamId == userTeamId()) ||
        isOwner(resource)
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        isSuperAdmin() || isManager() || isOwner(resource)
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() || (isAdmin() && resource.data.teamId == userTeamId())
      );
    }

    // ── CAMPAIGNS collection ──────────────────────────────────
    match /campaigns/{campaignId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || sameTeam(resource)
      );
      allow create: if isSignedIn() && (
        isManager() || isSuperAdmin()
      ) && request.resource.data.teamId == userTeamId();
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isManager() && sameTeam(resource)) ||
        isOwner(resource)
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() || (isAdmin() && sameTeam(resource))
      );
    }

    // ── TICKETS collection ────────────────────────────────────
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        sameTeam(resource)
      );
      allow create: if isSignedIn()
        && request.resource.data.teamId == userTeamId();
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (canManageTickets() && sameTeam(resource)) ||
        isAssignee(resource) ||
        isOwner(resource)
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() || (isAdmin() && sameTeam(resource))
      );
    }

    // ── ARTICLES (knowledge base) ─────────────────────────────
    // Read: anyone signed-in. Write: admins only.
    match /articles/{articleId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        isSuperAdmin() || isAdmin() || isManager()
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() || isAdmin()
      );
    }

    // ── INSIGHTS (AI-generated) ───────────────────────────────
    // Each user sees only their own insights. Created by AI service
    // (writes via Admin SDK outside these rules).
    match /insights/{insightId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn(); // user can also self-create
      allow update: if isSignedIn() && (
        isSuperAdmin() || resource.data.userId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() || resource.data.userId == request.auth.uid
      );
    }

    // ── CHAT_THREADS (AI assistant) ───────────────────────────
    match /chat_threads/{threadId} {
      allow read, write: if isSignedIn() && (
        isSuperAdmin() || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/chat_threads/$(threadId)).data.userId == request.auth.uid
        );
      }
    }

    // ── Default deny ──────────────────────────────────────────
    // ── TASKS + REMINDERS ─────────────────────────────────────
    // Team-scoped. Anyone on the team can create and see them, since a
    // task is often assigned to someone other than its author. Only the
    // assignee, the author, or a manager may change one.
    match /tasks/{taskId} {
      allow read: if isSignedIn()
                  && (isSuperAdmin() || resource.data.teamId == userTeamId());
      allow create: if isSignedIn()
                    && request.resource.data.teamId == userTeamId()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.teamId == userTeamId() && (
          resource.data.assignedTo == request.auth.uid ||
          resource.data.createdBy == request.auth.uid ||
          isManager()
        ))
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (resource.data.teamId == userTeamId() &&
          (resource.data.createdBy == request.auth.uid || isManager()))
      );
    }

    // ── Call logs ──────────────────────────────────────────────
    // Append-only history. A caller may write their own entries and read
    // their own; managers see the whole team. Nobody edits or deletes,
    // because an alterable audit trail is not an audit trail.
    match /call_logs/{logId} {
      allow read: if isSignedIn()
                  && (resource.data.callerId == request.auth.uid
                      || (isManager() && resource.data.teamId == userTeamId()));
      allow create: if isSignedIn()
                    && request.resource.data.callerId == request.auth.uid
                    && request.resource.data.teamId == userTeamId();
      allow update, delete: if false;
    }

    // ── Audit trail ────────────────────────────────────────────
    // Written by privileged actions, readable only by super admins.
    match /audit_logs/{entryId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin() || isManager();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
